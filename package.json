{
  "name": "ai-news-ingest",
  "description": "AI 日報 — Markdown → Supabase DB-first ingest pipeline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "ingest:json": "tsx ingest/cli/index.ts json",
    "candidates": "tsx ingest/cli/index.ts candidates",
    "fulltext": "tsx ingest/cli/index.ts fulltext",
    "ingest:backfill": "tsx ingest/cli/index.ts backfill --force-seed",
    "ingest:day": "tsx ingest/cli/index.ts day",
    "reconcile:content-md": "tsx ingest/cli/index.ts reconcile-content-md"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
